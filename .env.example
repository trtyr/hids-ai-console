# 复制为 .env.local，实际凭据只保存在部署环境中（node --env-file=.env.local server.js）。
# 本文件等于「代码真读的键」全集（P003-T025 立、P003-T034/T037 补齐、P003-T045 加日志落盘三键：41 个键，键名与代码一一对应，改键名要同时改代码）。
# 标注「必填」的五项缺任何一项，业务 API 进程会拒绝启动并把缺的键名逐个列出来。

# ── 业务 API（server.js）────────────────────────────────────────────
# 运行态数据根（案卷 / 研判记录 / 基线 / 规则集 / 白板 / 提示词覆盖 / 升级包）；不配落 ~/.local/share/hids-ai-console
HIDS_DATA_DIR=
HIDS_HOST=127.0.0.1
HIDS_PORT=8080
# 必填 CLOUDWALKER_URL / CLOUDWALKER_API_TOKEN：牧云地址与 API Token（Token 少于 6 位会被 rpc-client.js 拒），同时用于 RPC 与 MCP
CLOUDWALKER_URL=
CLOUDWALKER_API_TOKEN=
# 必填 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL：模型服务地址、密钥、模型名（三项齐了研判能力才装配出来）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次模型请求超时，毫秒；不配按 90000
LLM_TIMEOUT_MS=
# 自动研判的输入方式：只能是 syslog（默认）或 poll；其他值拒绝启动（空值走缺省 syslog）
HIDS_TRIAGE_INPUT_MODE=syslog
HIDS_SYSLOG_HOST=127.0.0.1
HIDS_SYSLOG_PORT=15514
# 自动研判同时跑几条；非法值（0 / 负数 / 小数 / 非数 / 空串）回落 2。改完要重启进程
HIDS_TRIAGE_CONCURRENCY=2
# 自动研判队列上限（排队 + 在跑）；满了拒收并计入 summary().dropped
HIDS_TRIAGE_QUEUE_MAX=1000
# /api/status 探活缓存窗口，毫秒，落 30~60 秒；0 关闭缓存
HIDS_STATUS_TTL_MS=45000
# 详情失败后同类列表探活的复用窗口，毫秒
HIDS_PROBE_TTL_MS=5000
# 事件列表首批快照窗口，毫秒（轮询与研判筛选共用）
HIDS_LIST_SNAPSHOT_TTL_MS=15000
# 牧云事件时间（无时区）相对 UTC 的偏移分钟数，不配按 0
HIDS_SYSLOG_TIME_OFFSET_MINUTES=
# 案件目录根；不配落 <数据根>/cases
HIDS_CASES_DIR=
# Basic 认证：不配 HIDS_BASIC_AUTH_PASSWORD 就不启用认证（谁都能进），这是合法部署，不算缺配置
HIDS_BASIC_AUTH_USER=
HIDS_BASIC_AUTH_PASSWORD=
# 知识库写操作令牌（请求头 x-prompt-admin-token）与规则写操作令牌（x-rule-admin-token）
HIDS_PROMPT_ADMIN_TOKEN=
HIDS_RULE_ADMIN_TOKEN=
# 维护端入口地址；被 createServer 收着，路由里没有使用点
HIDS_MAINTENANCE_ENTRY_URL=
# 判据库目录；不配落仓内 wiki/
HIDS_WIKI_DIR=
# 提示词覆盖文件；不配落 <数据根>/prompt-overrides.json
HIDS_PROMPT_STORE_FILE=

# ── 日志落盘（log.js，P003-T045）──────────────────────────────────────
# 日志文件路径；**不配＝只上 stdout**（P003-T023 起的行为不变，这是合法部署）。配了就在 stdout 之外同份再落一份：
# 单文件超 HIDS_LOG_MAX_BYTES（缺省 10 MiB）轮转成 <名>.<时刻>.log，历史文件只留最新 HIDS_LOG_KEEP 份（缺省 5）。
# 两个上限键非法值（0 / 负数 / 小数 / 非数）回落缺省。轮转文件仍以 .log 结尾，/api/data/inventory 的 logs 类看得见它们；
# 查询与清理走 /api/logs 与 /api/logs/cleanup（docs/modules/http-api.md §3.8）。
HIDS_LOG_FILE=
HIDS_LOG_MAX_BYTES=
HIDS_LOG_KEEP=

# ── 维护 API 与策略包（maintenance-server.js / package-policy.js）────
# 非预览模式下 HIDS_MAINTENANCE_USER 与 HIDS_MAINTENANCE_PASSWORD 必填
HIDS_MAINTENANCE_USER=
HIDS_MAINTENANCE_PASSWORD=
# 只能为 updater（默认）或 viewer
HIDS_MAINTENANCE_ROLE=
# 维护 API 端口，监听地址写死回环，不配按 18081
HIDS_MAINTENANCE_PORT=
# 升级包密钥：32 字节对称加密密钥、Ed25519 验签公钥、签名私钥（只在制作包时用）
HIDS_UPDATE_KEY_FILE=
HIDS_UPDATE_PUBLIC_KEY_FILE=
HIDS_UPDATE_PRIVATE_KEY_FILE=
# 已上传升级包的存放目录；不配落 <数据根>/update-packages
HIDS_UPDATE_STORE_DIR=
# 目标环境标识，包与环境的匹配依据
HIDS_UPDATE_TARGET=

# ── 前端页面服务（web/serve.js）─────────────────────────────────────
HIDS_API_ORIGIN=http://127.0.0.1:8080
HIDS_WEB_PORT=3000
HIDS_WEB_HOST=127.0.0.1
